# Copy this file to .env, then replace the placeholders with your own values.
# The real .env file is ignored by Git.

NODE_ENV=development
PORT=4173
DATA_DIR=./data

# Admin login used by the current local server.
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=replace-with-a-strong-password

# In local development, leave this unset so the server can generate it and save
# it under data/local-secrets.json. For production, use a random secret of at
# least 32 characters for JWT_SECRET.
# JWT_SECRET=

# Supabase Postgres credentials used by the Node server.
# Never put the Supabase secret/service-role key in browser code or commit it to Git.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-server-secret-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable-your-project-key
VOTER_EMAIL_DOMAINS=std.ewubd.edu,ewu.edu.bd

# If your Supabase dashboard only provides the legacy service_role key, use it
# instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

ENABLE_BALLOT_ACCEPTANCE=false

# Optional EVM relay settings. Keep the private key server-only. The configured
# contract's verificationAuthority must match the address derived from it.
# EVM_RPC_URL=https://your-testnet-rpc.example
# ELECTION_CONTRACT_ADDRESS=0x...
# RELAYER_PRIVATE_KEY=0x...

# Ballot acceptance also has a hard-coded false readiness gate. Do not deploy it
# for real voting until a distributed key ceremony, reviews, and tally settlement.
