# Copy this file to .env, then replace the placeholders with your own values.
# The real .env file is ignored by Git.

NODE_ENV=development
PORT=4173
DATA_DIR=./data

# Admin login used by the current local server.
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=replace-with-a-strong-password

# In local development, leave these unset so the server can generate them and
# save them under data/local-secrets.json. For production, use two distinct
# random secrets of at least 32 characters for JWT_SECRET and OTP_SECRET.
# JWT_SECRET=
# OTP_SECRET=

# Supabase Postgres credentials used by the Node server.
# Never put the Supabase secret/service-role key in browser code or commit it to Git.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-server-secret-key

# If your Supabase dashboard only provides the legacy service_role key, use it
# instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key
