NODE_ENV=development
PORT=4173
ADMIN_EMAIL=admin@demo.local
# Replace this sample password before running the app.
ADMIN_PASSWORD=replace-with-a-strong-local-password
# The server generates a stable local-development JWT secret if it is omitted.
# For production, use a random JWT secret of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
DATA_DIR=./data

# Supabase Postgres. These values are used only by the Node server.
SUPABASE_URL=https://your-project-ref.supabase.co
# Public key used by the browser Supabase Auth client; safe to expose.
SUPABASE_PUBLISHABLE_KEY=sb_publishable-replace-with-your-project-key
# Exact domains allowed to create voter registrations, comma-separated.
VOTER_EMAIL_DOMAINS=std.ewubd.edu,ewu.edu.bd
# Prefer a Supabase secret key. A legacy service_role key also works server-side.
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-key

# Leave disabled. The server also has a hard-coded readiness gate that blocks acceptance.
ENABLE_BALLOT_ACCEPTANCE=false

# Optional EVM relay settings. The configured contract's verificationAuthority must
# match the address derived from RELAYER_PRIVATE_KEY. Never put this key in browser code.
# EVM_RPC_URL=https://your-testnet-rpc.example
# ELECTION_CONTRACT_ADDRESS=0x...
# RELAYER_PRIVATE_KEY=0x...

# Voting remains disabled until independent review, a real distributed key ceremony,
# production database deployment checks, and on-chain tally settlement are complete.
