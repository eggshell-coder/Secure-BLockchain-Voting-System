NODE_ENV=development
PORT=4173
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=change-this-local-password
# The server generates stable local-development values when these are omitted.
# For production, use distinct random values of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-another-long-random-secret
DATA_DIR=./data

# Supabase Postgres. These values are used only by the Node server.
SUPABASE_URL=https://your-project-ref.supabase.co
# Prefer a Supabase secret key. A legacy service_role key also works server-side.
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-key

# Real voting remains disabled until audited credential, ballot-encryption,
# eligibility-proof, and tally-proof implementations are configured.
